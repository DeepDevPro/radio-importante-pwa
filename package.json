{
  "name": "radio-importante",
  "version": "2.2.8",
  "description": "PWA Music Player - Radio Importante (Staging Ready)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "release": "echo \"Use: git tag v1.0.0 && git push origin v1.0.0\"",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:staging": "vite build --mode staging",
    "build:prod": "vite build --mode production",
    "build:deploy": "tsc --noEmit && vite build",
    "build:production": "./build-production.sh",
    "deploy:prepare": "npm run build:production && echo 'Arquivos prontos em dist/ - Suba para S3!'",
    "deploy:check": "./check-s3-deploy.sh",
    "preview": "vite preview",
    "lint": "eslint \"**/*.{ts,tsx,js}\" --report-unused-disable-directives",
    "lint:fix": "eslint \"**/*.{ts,tsx,js}\" --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,html}'",
    "catalog": "node scripts/generateCatalog.js",
    "catalog:watch": "npm run catalog && npm run dev",
    "audio": "node scripts/generate-audio.js",
    "audio:analyze": "node scripts/generate-audio.js --analyze-only",
    "audio:remote": "node scripts/generate-audio-remote.js",
    "hls:generate": "node scripts/generate-hls.js",
    "hls:clean": "rm -rf public/audio/hls"
  },
  "keywords": [
    "pwa",
    "music-player",
    "radio",
    "ios",
    "android"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.676.0",
    "@aws-sdk/lib-storage": "^3.676.0",
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "dependencies": {
    "@aws-sdk/s3-request-presigner": "^3.908.0"
  }
}
