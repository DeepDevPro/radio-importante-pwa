# Variáveis de ambiente para desenvolvimento e produção
NODE_ENV=production
PORT=3001

# Digital Ocean Spaces Configuration (substitui AWS S3)
DO_SPACES_ENDPOINT=nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=radio-importante-audio
DO_SPACES_KEY=your_spaces_access_key_here
DO_SPACES_SECRET=your_spaces_secret_key_here

# Application Configuration
CATALOG_PATH=/tmp/catalog.json

# CORS Origins (separados por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://radio.importantestudio.com

# Optional - for custom CDN domains
# DO_SPACES_CDN_URL=https://your-custom-domain.com
